@page "/profile"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization 
@using practppi.Services 

@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<AuthorizeView>
    <Authorized>
        <div class="container mt-4 mb-5">
            <div class="row">
                <!-- БЛОК 1: Інформація про користувача -->
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <img src="images/account-icon.png" class="rounded-circle mb-3" style="width: 100px; height: 100px; object-fit: cover; background: #eee;" />
                            
                            <h4 class="fw-bold">@(userInfo?.Username ?? "Користувач")</h4>
                            <p class="text-muted">@(userInfo?.Email ?? "")</p>
                            
                            <button class="btn btn-outline-danger btn-sm mt-2" @onclick="Logout">Вийти</button>
                        </div>
                    </div>

                    <!-- БЛОК 2: Параметри тіла -->
                    <div class="card shadow-sm border-0 mt-3">
                        <div class="card-header bg-white border-0 fw-bold">Параметри тіла</div>
                        <div class="card-body">
                            @if (bodyParams == null)
                            {
                                <div class="text-center py-2 text-muted">Завантаження...</div>
                            }
                            else
                            {
                                <div class="mb-2">
                                    <label class="small text-muted">Sex</label>
                                    <select class="form-select" @bind="bodyParams.Gender">
                                        <option value="Male">Чоловіча</option>
                                        <option value="Female">Жіноча</option>
                                        <option value="Female">Був)</option>
                                        <option value="Female">Не було(</option>                                        
                                    </select>
                                </div>

                                <div class="mb-2">
                                    <label class="small text-muted">Вага (кг)</label>
                                    <input type="number" class="form-control" @bind="bodyParams.Weight" />
                                </div>
                                <div class="mb-3">
                                    <label class="small text-muted">Зріст (см)</label>
                                    <input type="number" class="form-control" @bind="bodyParams.Height" />
                                </div>
                                
                                <button class="btn btn-dark w-100" @onclick="SaveBodyParams" disabled="@isSavingParams">
                                    @(isSavingParams ? "Збережено!" : "Зберегти")
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <!-- БЛОК 3: Улюблені тренування -->
                <div class="col-md-8">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold mb-0">❤️ Улюблені тренування</h5>
                            <span class="badge bg-danger rounded-pill">@likedWorkoutsList.Count</span>
                        </div>
                        <div class="card-body">
                            @if (isLoading)
                            {
                                <div class="text-center py-4">
                                    <div class="spinner-border text-danger spinner-border-sm"></div>
                                </div>
                            }
                            else if (likedWorkoutsList.Count == 0)
                            {
                                <div class="text-center text-muted py-5">
                                    <span style="font-size: 2rem;">📭</span>
                                    <p class="mt-2">Ви ще не додали жодного тренування в улюблені.</p>
                                    <a href="/workouts" class="btn btn-outline-dark btn-sm">Перейти до каталогу</a>
                                </div>
                            }
                            else
                            {
                                <div class="row g-3">
                                    @foreach (var workout in likedWorkoutsList)
                                    {
                                        <div class="col-md-6">
                                            <div class="card h-100 border bg-light">
                                                <div class="card-body">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <h6 class="fw-bold text-truncate" title="@workout.Name">@workout.Name</h6>
                                                        <button class="btn btn-link text-danger p-0 ms-2" @onclick="() => RemoveFromLiked(workout.Id)" title="Видалити">✕</button>
                                                    </div>
                                                    <p class="small text-muted mb-2 text-truncate">@workout.Description</p>
                                                    <a href="/workout/@workout.Id" class="btn btn-sm btn-white border w-100 text-dark">Відкрити</a>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container mt-5 text-center">
            <h3>Доступ обмежено</h3>
            <a href="/login" class="btn btn-primary">Увійти</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private UserProfileDto? userInfo;
    private UserBodyParams? bodyParams;
    private List<WorkoutDto> likedWorkoutsList = new();
    
    private bool isLoading = true;
    private bool isSavingParams = false; // Для візуалізації збереження

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var client = await GetHttpClientWithToken();
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            // 1. ЗАВАНТАЖЕННЯ ПАРАМЕТРІВ ТІЛА З LOCALSTORAGE
            // Ми робимо це тут, щоб користувач одразу бачив свої дані
            var storedParams = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "myBodyParams");
            if (!string.IsNullOrEmpty(storedParams))
            {
                try 
                {
                    bodyParams = JsonSerializer.Deserialize<UserBodyParams>(storedParams);
                }
                catch { /* Ігноруємо помилки JSON */ }
            }
            
            // Якщо нічого не знайдено, ініціалізуємо дефолтними
            if (bodyParams == null)
            {
                bodyParams = new UserBodyParams { Gender = "Male", Height = 175, Weight = 70 };
            }

            // 2. ЗАВАНТАЖЕННЯ ПРОФІЛЮ З API
            var profileResponse = await client.GetAsync("/api/users/me");
            if (profileResponse.IsSuccessStatusCode)
            {
                userInfo = await profileResponse.Content.ReadFromJsonAsync<UserProfileDto>(options);
                
                var favIds = userInfo?.FavoriteWorkoutsIds 
                          ?? userInfo?.Favorites 
                          ?? userInfo?.LikedWorkouts 
                          ?? new List<string>();

                // 3. ЗАВАНТАЖЕННЯ ДЕТАЛЕЙ УЛЮБЛЕНИХ ТРЕНУВАНЬ
                if (favIds.Any())
                {
                    try 
                    {
                        var allWorkouts = await client.GetFromJsonAsync<List<WorkoutDto>>("/api/workouts", options);
                        if (allWorkouts != null)
                        {
                            likedWorkoutsList = allWorkouts.Where(w => favIds.Contains(w.Id)).ToList();
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error loading workouts details: {ex.Message}");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveBodyParams()
    {
        isSavingParams = true;
        StateHasChanged();

        try
        {
            // Зберігаємо в LocalStorage (як у вашому старому файлі)
            var json = JsonSerializer.Serialize(bodyParams);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "myBodyParams", json);
            
            // Невелика затримка для візуального ефекту "Збережено!"
            await Task.Delay(1000);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving params: {ex.Message}");
        }
        finally
        {
            isSavingParams = false;
            StateHasChanged();
        }
    }

    private async Task RemoveFromLiked(string workoutId)
    {
        var itemToRemove = likedWorkoutsList.FirstOrDefault(w => w.Id == workoutId);
        if (itemToRemove != null)
        {
            likedWorkoutsList.Remove(itemToRemove);
            StateHasChanged();
        }

        try
        {
            var client = await GetHttpClientWithToken();
            await client.PutAsync($"/api/users/likeButton/{workoutId}", null);
        }
        catch { }
    }

    private async Task Logout()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "accessToken");
        ((CustomAuthStateProvider)AuthStateProvider).MarkUserAsLoggedOut();
        NavigationManager.NavigateTo("/login");
    }

    private async Task<HttpClient> GetHttpClientWithToken()
    {
        var client = HttpClientFactory.CreateClient("Api");
        var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "accessToken");
        if (!string.IsNullOrEmpty(token))
        {
            client.DefaultRequestHeaders.Authorization = 
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
        return client;
    }

    public class UserProfileDto
    {
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        
        [JsonPropertyName("favoriteWorkoutsIds")] 
        public List<string>? FavoriteWorkoutsIds { get; set; }
        
        [JsonPropertyName("favorites")]
        public List<string>? Favorites { get; set; }
        
        [JsonPropertyName("likedWorkouts")]
        public List<string>? LikedWorkouts { get; set; }
    }

    public class UserBodyParams
    {
        public string Gender { get; set; } = "Male";
        public double? Height { get; set; }
        public double? Weight { get; set; }
    }
    
    public class WorkoutDto
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        [JsonPropertyName("tagsIds")]
        public List<string>? TagsIds { get; set; }
        [JsonPropertyName("tags")]
        public List<TagDto>? Tags { get; set; }
    }

    public class TagDto
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
    }
}