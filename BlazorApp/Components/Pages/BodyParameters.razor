@page "/body-parameters"
@rendermode InteractiveServer
@using System.Text.Json
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<div class="registration-container">
    <h3>Мої параметри</h3>
    <p class="text-muted">Ці дані зберігаються лише у вашому браузері для розрахунків.</p>

    <EditForm Model="@userParams" OnValidSubmit="SaveParameters" FormName="body-params-form">
        <DataAnnotationsValidator />

        <!-- Стать (Пол) -->
        <div class="input-field">
            <label>Sex</label>
            <InputSelect @bind-Value="userParams.Gender" class="form-control">
                <option value="Чоловік">Чоловіча</option>
                <option value="Жінка">Жіноча</option>
                <option value="Не було">Не було</option>
                <option value="Був">Був</option>
            </InputSelect>
        </div>

        <!-- Зріст -->
        <div class="input-field mt-3">
            <label>Зріст (см)</label>
            <InputNumber @bind-Value="userParams.Height" class="form-control" placeholder="Наприклад: 180" />
        </div>

        <!-- Вага -->
        <div class="input-field mt-3">
            <label>Вага (кг)</label>
            <InputNumber @bind-Value="userParams.Weight" class="form-control" placeholder="Наприклад: 75" />
        </div>

        <!-- Уведомление об успехе -->
        @if (isSaved)
        {
            <div class="alert alert-success mt-3" role="alert">
                Дані успішно збережено!
            </div>
        }

        <div class="buttons-container mt-4">
            <button type="submit" class="btn-continue">Зберегти</button>
            <a href="/" class="btn-cancel" style="text-decoration: none;">На головну</a>
        </div>
    </EditForm>
</div>

@code {
    private UserBodyParams userParams = new UserBodyParams();
    private bool isSaved = false;

    // Класс для хранения данных
    public class UserBodyParams
    {
        public string Gender { get; set; } = "Male"; // Значение по умолчанию
        public double? Height { get; set; }
        public double? Weight { get; set; }
    }

    // Этот метод запускается ПОСЛЕ того, как страница отрисовалась.
    // Только здесь можно безопасно работать с localStorage в Blazor Server.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Пытаемся достать сохраненные данные из браузера
            var storedJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "myBodyParams");
            
            if (!string.IsNullOrEmpty(storedJson))
            {
                try 
                {
                    userParams = JsonSerializer.Deserialize<UserBodyParams>(storedJson) ?? new UserBodyParams();
                    // Обновляем интерфейс, так как данные загрузились асинхронно
                    StateHasChanged();
                }
                catch { /* Если JSON поврежден, просто игнорируем */ }
            }
        }
    }

    private async Task SaveParameters()
    {
        // Превращаем объект в строку JSON
        var json = JsonSerializer.Serialize(userParams);

        // Сохраняем в браузер под ключом "myBodyParams"
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "myBodyParams", json);

        isSaved = true;
        
        // Скрываем сообщение об успехе через 3 секунды
        await Task.Delay(3000);
        isSaved = false;
        StateHasChanged();
    }
}