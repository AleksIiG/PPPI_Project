@page "/login"
@rendermode InteractiveServer 
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Components.Forms

@inject NavigationManager NavigationManager 
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime

<div class="registration-container">
    <h3>Вхід в обліковий запис</h3>

    <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" FormName="login-form">
        <DataAnnotationsValidator />

        <div class="input-field">
            <label>E-mail</label>
            <InputText @bind-Value="loginModel.Email" />
            <ValidationMessage For="@(() => loginModel.Email)" /> 
        </div>

        <div class="input-field">
            <label>Пароль</label>
            <InputText @bind-Value="loginModel.Password" type="password" />
            <ValidationMessage For="@(() => loginModel.Password)" />
        </div>
        
        @if (!string.IsNullOrEmpty(loginError))
        {
            <div class="alert alert-danger" role="alert">
                @loginError
            </div>
        }

        <div class="buttons-container">
            <button type="submit" class="btn-continue" disabled="@isSubmitting">
                @if(isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span> Вхід...</span>
                }
                else
                {
                    <span>Увійти</span>
                }
            </button>
            <a href="/" class="btn-cancel" style="text-decoration: none;">ВІДМІНА</a>
        </div>
        
    </EditForm>
</div>

@code {
    // Добавляем [SupplyParameterFromForm], чтобы данные не терялись при отправке
    [SupplyParameterFromForm]
    private LoginModel loginModel { get; set; } = new LoginModel();

    public class LoginModel
    {
        [Required(ErrorMessage = "Введіть E-mail")]
        [EmailAddress(ErrorMessage = "Некоректний формат E-mail")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Введіть пароль")]
        public string Password { get; set; } = "";
    }

    private class AuthResponse
    {
        [JsonPropertyName("accessToken")]
        public string AccessToken { get; set; } = "";

        [JsonPropertyName("refreshToken")]
        public string RefreshToken { get; set; } = "";
    }
    
    private bool isSubmitting = false;
    private string? loginError;

    private async Task HandleLogin()
    {
        isSubmitting = true;
        loginError = null; 

        try
        {
            var httpClient = HttpClientFactory.CreateClient("Api");
            var response = await httpClient.PostAsJsonAsync("/api/auth/login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                var authResponse = await response.Content.ReadFromJsonAsync<AuthResponse>();

                if (authResponse != null && !string.IsNullOrEmpty(authResponse.AccessToken))
                {
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "accessToken", authResponse.AccessToken);
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "refreshToken", authResponse.RefreshToken);
                    
                    NavigationManager.NavigateTo("/", forceLoad: true); 
                }
                else
                {
                    loginError = "Помилка: API повернув успіх, але не повернув токен.";
                }
            }
            else
            {
                // Для безопасности часто пишут просто "Неверные данные", 
                // но для отладки можно вывести статус код
                loginError = "Неправильний E-mail або пароль.";
            }
        }
        catch (Exception ex)
        {
            loginError = $"Помилка з'єднання: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}